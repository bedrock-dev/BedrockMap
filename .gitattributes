# Keep every text file LF in the repository and in working trees.
* text=auto eol=lf

# Qt translation files: lupdate emits LF.
*.ts text eol=lf

*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf
*.qml text eol=lf
*.js text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Binary assets must never be normalized or diffed as text.
*.a binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.ttf binary
*.webp binary
*.woff binary
*.woff2 binary
